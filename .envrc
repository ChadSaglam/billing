# R-43: auto-activate the project venv when you cd into the repo, so
# manual pytest/pip never touch the system Python. Needs direnv:
#   brew install direnv && echo 'eval "$(direnv hook zsh)"' >> ~/.zshrc
# Without direnv installed this file is simply ignored.
source backend/venv/bin/activate 2>/dev/null || echo "backend/venv missing — run ./scripts/setup.sh local"
