# ─── App ──────────────────────────────────────────────────
APP_NAME=Billing
# development | production. production disables /api/seed and --reload.
APP_ENV=development
# Python logging level. Logs are JSON lines on stdout (R-27).
LOG_LEVEL=INFO
# Sentry error tracking; empty = disabled (R-91).
SENTRY_DSN=

# ─── Ports (single source of truth for local AND docker) ──
# billing: 5050 (frontend) / 9000 (API) / 9432 (Postgres). Buchhaltung owns
# 3000 / 8000 / 5432, so both stacks can run side by side.
FRONTEND_PORT=5050
BACKEND_PORT=9000
DB_PORT=9432

# ─── URLs ─────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5050
VITE_API_URL=http://localhost:9000
# Comma-separated. A JSON list breaks when this file is exported into the
# environment, because the shell strips the quotes (R-36).
ALLOWED_ORIGINS=http://localhost:5050

# ─── Secrets ──────────────────────────────────────────────
# python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# ─── Database ─────────────────────────────────────────────
POSTGRES_USER=chadev
POSTGRES_PASSWORD=change-me
POSTGRES_DB=billing
# Local runs connect through the published port above.
DATABASE_URL=postgresql://chadev:change-me@localhost:9432/billing

# ─── Email ────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=

# ─── Upload storage (R-90) ────────────────────────────────
# local | s3. local stores under backend/uploads and only works with ONE
# app replica; use s3 (any S3-compatible bucket) when scaling out.
STORAGE_BACKEND=local
S3_BUCKET=
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=
# Base URL under which bucket objects are publicly reachable (CDN or bucket URL).
S3_PUBLIC_BASE_URL=

# ─── Scheduled jobs (R-84) ────────────────────────────────
# Overdue marking + recurring invoices. true = the API runs them in-process
# (local dev, single container). docker-compose.yml overrides this to false
# on the backend and runs the `jobs` service (`python -m app.jobs`) instead.
RUN_JOBS_IN_API=true
JOBS_INTERVAL_SECONDS=3600

# ─── ChaDev platform (R-103 SSO, R-104 events) ────────────
# Shared with buchhaltung's .env (same value in both). Signs the SSO
# hand-off token and the HMAC on outbound events; separate from SECRET_KEY.
# Empty = SSO endpoints answer 404 and events are recorded but never sent.
# python3 -c "import secrets; print(secrets.token_hex(32))"
PLATFORM_SHARED_SECRET=
# Browser-facing buchhaltung URL (app switcher + SSO redirect base).
BUCHHALTUNG_URL=http://localhost:3000
# Server-to-server buchhaltung API base for platform events. Local dev
# (uvicorn on the host): http://localhost:8000. Docker: leave empty — the
# compose file then defaults it to http://host.docker.internal:8000.
BUCHHALTUNG_API_URL=

# ─── Test account used by scripts/test.sh ─────────────────
TEST_EMAIL=
TEST_PASSWORD=

# ─── SaaS (not yet enforced — see ROADMAP R-11) ───────────
SIGNUP_ENABLED=true
DEFAULT_PLAN=trial
TRIAL_DAYS=14
