# ─────────────────────────────────────────────────────────────
# Billing — environment template
# Copy to .env and fill in. NEVER commit .env.
#   cp .env.example .env && ./scripts/gen-secret.sh
# ─────────────────────────────────────────────────────────────

# App
APP_NAME=Billing
APP_ENV=development            # development | staging | production

# Ports (see CLAUDE.md — this project owns the 92xx block)
FRONTEND_PORT=9200
BACKEND_PORT=9201
DB_PORT=9202

# Database
POSTGRES_USER=billing
POSTGRES_PASSWORD=             # required — generate a strong one
POSTGRES_DB=billing
DATABASE_URL=postgresql://billing:CHANGE_ME@localhost:9202/billing

# Auth — REQUIRED in production, app refuses to start without it.
# Generate with: openssl rand -hex 32
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# URLs
FRONTEND_URL=http://localhost:9200
ALLOWED_ORIGINS=["http://localhost:9200"]
VITE_API_URL=http://localhost:9201

# SaaS
SIGNUP_ENABLED=true
DEFAULT_PLAN=trial
TRIAL_DAYS=14

# Email (optional in dev — leave blank to disable sending)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=
