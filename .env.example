# ─── App ──────────────────────────────────────────────────
APP_NAME=Billing
# development | production. production disables /api/seed and --reload.
APP_ENV=development
# Python logging level. Logs are JSON lines on stdout (R-27).
LOG_LEVEL=INFO
# Sentry error tracking; empty = disabled (R-91).
SENTRY_DSN=

# ─── Ports (single source of truth for local AND docker) ──
# This project owns the 92xx block.
FRONTEND_PORT=9200
BACKEND_PORT=9201
DB_PORT=9202

# ─── URLs ─────────────────────────────────────────────────
FRONTEND_URL=http://localhost:9200
VITE_API_URL=http://localhost:9201
# Comma-separated. A JSON list breaks when this file is exported into the
# environment, because the shell strips the quotes (R-36).
ALLOWED_ORIGINS=http://localhost:9200

# ─── Secrets ──────────────────────────────────────────────
# python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# ─── Database ─────────────────────────────────────────────
POSTGRES_USER=chadev
POSTGRES_PASSWORD=change-me
POSTGRES_DB=billing
# Local runs connect through the published port above.
DATABASE_URL=postgresql://chadev:change-me@localhost:9202/billing

# ─── Email ────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=

# ─── Upload storage (R-90) ────────────────────────────────
# local | s3. local stores under backend/uploads and only works with ONE
# app replica; use s3 (any S3-compatible bucket) when scaling out.
STORAGE_BACKEND=local
S3_BUCKET=
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=
# Base URL under which bucket objects are publicly reachable (CDN or bucket URL).
S3_PUBLIC_BASE_URL=

# ─── Test account used by scripts/test.sh ─────────────────
TEST_EMAIL=
TEST_PASSWORD=

# ─── SaaS (not yet enforced — see ROADMAP R-11) ───────────
SIGNUP_ENABLED=true
DEFAULT_PLAN=trial
TRIAL_DAYS=14
